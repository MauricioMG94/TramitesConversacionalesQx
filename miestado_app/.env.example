# ══════════════════════════════════════════════════
# MiEstadoApp · variables de entorno
# Copiar como .env y completar valores sensibles.
# ══════════════════════════════════════════════════

# ── Dominio publico (usado por nginx-proxy para emitir HTTPS automatico) ──
# 'localhost' para dev local en el VPS sin proxy.
# 'miestadoapp.online' (o tu dominio real) para produccion.
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@miestadoapp.online

# Red externa donde vive el contenedor nginx-proxy del VPS (no tocar salvo
# que uses otro proxy). Si tienes varios proyectos, todos comparten esta red.
PROXY_NETWORK=nginx-proxy_default

# ── Aplicación ──
APP__ENV=dev
APP__TZ=America/Bogota
API_HOST=0.0.0.0
API_PORT=8888

# ── CORS ──
# En produccion con nginx-proxy, el frontend y la api comparten dominio,
# asi que el origen del frontend es lo unico que necesita autorizacion.
# Si sirves la api en un subdominio aparte (api.miestadoapp.online), agregalo.
CORS_ORIGINS=https://${DOMAIN},http://localhost:5173,http://localhost:3000

# ── Frontend (VITE_API_BASE es build-time, queda embebido en el bundle JS) ──
# Por default usamos una ruta RELATIVA /api para aprovechar el proxy
# nginx del contenedor del frontend (mismo origen -> sin CORS).
# Si necesitas un backend externo, exportar antes del build:
#   VITE_API_BASE=https://api.example.com
VITE_API_BASE=/api
FRONTEND_EXTERNAL_PORT=5173

# ── MongoDB ──
# En docker-compose el host es el nombre del servicio.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=miestado
MONGO_URI=mongodb://mongo:27017

# ── Seguridad (JWT) ──
# Clave secreta para firmar los tokens JWT. Generar larga/aleatoria en producción.
SECRET_KEY=cambiar-esta-clave-en-produccion-please-make-it-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Logging ──
LOG_LEVEL=INFO

# ── Seed inicial del primer administrador ──
SEED_ADMIN_ENABLED=true
SEED_ADMIN_CORREO=admin@miestado.local
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CONTRASENA=CambiarEnProduccion123*
SEED_ADMIN_ROL=admin
