# ══════════════════════════════════════════════════
# MiEstadoApp · variables de entorno
# Copiar como .env y completar valores sensibles.
# ══════════════════════════════════════════════════

# ── Aplicación ──
APP__ENV=dev
APP__TZ=America/Bogota
API_HOST=0.0.0.0
API_PORT=8888

# ── CORS ──
# Separar por coma. En produccion incluir el dominio del frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8888

# ── Frontend (VITE_API_BASE es build-time, queda embebido en el bundle JS) ──
# URL desde la que el navegador llamara a la API. Apunta al host:puerto
# publicados de la API en tu maquina.
VITE_API_BASE=http://localhost:8888
FRONTEND_EXTERNAL_PORT=5173

# ── MongoDB ──
# En docker-compose el host es el nombre del servicio.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=miestado
MONGO_URI=mongodb://mongo:27017

# ── Seguridad (JWT) ──
# Clave secreta para firmar los tokens JWT. Generar larga/aleatoria en producción.
SECRET_KEY=cambiar-esta-clave-en-produccion-please-make-it-long-and-random
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Logging ──
LOG_LEVEL=INFO

# ── Seed inicial del primer administrador ──
SEED_ADMIN_ENABLED=true
SEED_ADMIN_CORREO=admin@miestado.local
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_CONTRASENA=CambiarEnProduccion123*
SEED_ADMIN_ROL=admin

# ── RUNT (Registro Unico Nacional de Transito) ──
# Modo mock resuelve en memoria por placa; usalo para piloto sin credenciales.
# Cambia a "real" cuando tengas client_id/client_secret y (opcional) mTLS.
RUNT_ENABLED=true
RUNT_MODE=mock
RUNT_BASE_URL=https://pruebas-api.runt.example.gov.co
RUNT_TIMEOUT_SECONDS=15

# Credenciales OAuth2 client_credentials (solo necesarias en mode=real).
RUNT_CLIENT_ID=your-client-id
RUNT_CLIENT_SECRET=your-client-secret

# mTLS opcional (solo si RUNT lo exige). Las rutas se montan en el contenedor
# desde ./secrets/runt/ (/secrets/runt/client.crt, /secrets/runt/client.key,
# /secrets/runt/ca.pem). No las commitees.
RUNT_MTLS_ENABLED=false
RUNT_CERT_PATH=/secrets/runt/client.crt
RUNT_KEY_PATH=/secrets/runt/client.key
RUNT_CA_PATH=/secrets/runt/ca.pem

# ── Bot conversacional ──
CHAT_ENABLED=true
CHAT_PERSIST_CONVERSACIONES=true
CHAT_MAX_HISTORIAL=10
CHAT_DEBUG_VEHICULO=false
