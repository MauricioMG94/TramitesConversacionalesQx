# Caddyfile - Reverse proxy dedicado de MiEstadoApp.
#
# Solo enruta el dominio configurado en .env (DOMAIN). NO comparte la
# responsabilidad con ningun otro reverse proxy del VPS: este Caddy
# escucha unicamente en 80/443 y rechaza conexiones a cualquier otro
# Host header.
#
# Caddy emite automaticamente el cert de Let's Encrypt via HTTP-01
# (necesita DNS A apuntando a la IP del VPS y 80/443 alcanzables desde
# internet). Renueva solo cuando faltan menos de 30 dias para vencer.

{$DOMAIN:miestadoapp.online} {
    # Seguridad basica.
    encode gzip zstd
    header {
        # Evitar que tu app se pueda embeber en iframes de terceros.
        X-Frame-Options "SAMEORIGIN"
        # Forzar HTTPS por un anio cuando el cliente ya negocia TLS.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Saneamiento del header Referer.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Bloquear sniffing de MIME.
        X-Content-Type-Options "nosniff"
        # Ocultar server header (Caddy por defecto lo expone).
        -Server
    }

    # Backend publico: el frontend ya hace proxy_pass /api/ -> api:8888
    # internamente, asi que aqui solo necesitamos reenviar todo al
    # contenedor del frontend.
    reverse_proxy frontend:3000 {
        # Timeout holgado para evitar 504 durante el primer handshake
        # TLS al backend de Mongo.
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
        }
        # Cabecera informativa para debugging en el backend.
        header_up X-Forwarded-Proto "https"
        header_up X-Real-IP {remote_host}
    }

    # Logs estructurados (Nivel info por default; DEBUG solo en depuracion).
    log {
        output stdout
        format console
        level INFO
    }
}
